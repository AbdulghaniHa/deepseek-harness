{
  "name": "@deepseek-ai/dsh-browser-chrome-extension",
  "description": "Chrome Native Messaging provider for the DeepSeek Harness browser capability seam (ctx.browser)",
  "version": "0.1.3-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/browser/browser-chrome-extension"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./install": {
      "types": "./lib/types/install/index.d.ts",
      "default": "./lib/install.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/host.js",
    "lib/install.js",
    "bin/dsh-browser-host",
    "bin/dsh-browser-host.cmd",
    "extension",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-browser": "workspace:^",
    "@deepseek-ai/dsh-home-paths": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-browser": "workspace:^",
    "@deepseek-ai/dsh-home-paths": "workspace:^",
    "playwright": "^1.61.1"
  }
}
