{
  "manifest_version": 3,
  "name": "DeepSeek Harness",
  "version": "0.1.3",
  "description": "Lets DeepSeek Harness drive this Chrome profile through the page debugger.",
  "permissions": [
    "debugger",
    "nativeMessaging",
    "tabs",
    "tabGroups",
    "history",
    "bookmarks",
    "readingList",
    "downloads",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "DeepSeek Harness",
    "default_popup": "popup.html"
  }
}
